{
  "name": "msmcp",
  "version": "0.1.0",
  "description": "MCP server for Mixing Station: lets an AI client control a digital mixing console through Mixing Station's REST and WebSocket API",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "msmcp": "./dist/src/main.js"
  },
  "files": [
    "dist/src/",
    "profiles/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/destitutemusic/MsMcp.git"
  },
  "keywords": [
    "mcp",
    "mixing-station",
    "mixer",
    "audio",
    "daw"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/destitutemusic/MsMcp#readme",
  "bugs": {
    "url": "https://github.com/destitutemusic/MsMcp/issues"
  }
}
